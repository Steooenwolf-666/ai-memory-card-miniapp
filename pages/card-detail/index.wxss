.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f6f6f6;
}

.form {
  background: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.title-input {
  font-size: 32rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 6rpx;
}

.content-input {
  width: 100%;
  height: 400rpx;
  font-size: 28rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 6rpx;
}

.card-detail {
  background: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.card-content {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.card-status {
  font-size: 24rpx;
  color: #666;
}

.button-group {
  margin-top: 30rpx;
}

.primary-btn {
  background: #07c160;
  color: #fff;
  border: none;
  margin-bottom: 20rpx;
}

.review-btn {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  margin-bottom: 20rpx;
}

.delete-btn {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
} 